# ── Copy this file to .env and fill in real values ──────────────────────────
# cp .env.example .env

# Anthropic / Claude API key — powers dossiers and recommendations.
# Get one at https://console.anthropic.com/. The app still runs without it
# (it falls back to rule-based recommendations), but AI features need it.
ANTHROPIC_API_KEY=

# Claude model used for AI features.
AI_MODEL=claude-opus-4-8

# ── Authentication (IMPORTANT when the dashboard is public) ─────────────────
# Set a strong APP_PASSWORD to require login for the whole site + API. Leave
# empty only for local development. The Chater bridge authenticates with
# X-API-Key instead (set API_KEY, or it falls back to APP_PASSWORD).
APP_USERNAME=admin
APP_PASSWORD=
API_KEY=

# Database connection.
# Local quick start (no Postgres needed): leave as the sqlite line.
# Production / docker-compose: the compose file overrides this with Postgres.
DATABASE_URL=sqlite:///./networking.db
# DATABASE_URL=postgresql+psycopg://networking:networking@db:5432/networking

# How many people the dashboard suggests contacting each day.
DAILY_SUGGESTIONS=5

# Look-ahead window (days) for upcoming birthdays / key dates.
UPCOMING_WINDOW_DAYS=14

# CORS — comma separated list of allowed origins ("*" allows all).
CORS_ORIGINS=*

# ── Google integration (Gmail + Calendar auto-sync) ─────────────────────────
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and enable the Gmail API
# and Google Calendar API. Add the redirect URI below to the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an authorised redirect URI on the OAuth client.
# Local: http://localhost:8000/api/integrations/google/callback
# Prod:  https://your-domain/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# How many days back to pull emails / calendar events when syncing.
SYNC_WINDOW_DAYS=120

# ── Daily automation (background scheduler) ─────────────────────────────────
# Turn on the in-process scheduler that runs the daily job (warmth refresh,
# Google sync, digest email). For multi-process setups prefer a cron job
# calling:  python -m app.run_daily
SCHEDULER_ENABLED=false
DAILY_RUN_HOUR=8
# Where to send the daily digest. Defaults to your connected Google account.
DIGEST_EMAIL_TO=

# ── Social scraping provider (optional, for Instagram/LinkedIn) ─────────────
# A rendering/scraping API used to fetch JS-heavy pages. Supported: scrapingbee.
SCRAPER_PROVIDER=
SCRAPER_API_KEY=

# Score the tone of synced emails/meetings/messages with AI (needs ANTHROPIC_API_KEY).
SYNC_AI_SENTIMENT=true

# ── Chater importer (reuse your existing Telegram bot's database) ───────────
# Read-only PostgreSQL connection to the Chater database. Import brings in its
# contacts and Telegram message history. Example:
# postgresql+psycopg://user:pass@46.225.132.220:5432/chater
CHATER_DATABASE_URL=

# ── Telegram ────────────────────────────────────────────────────────────────
# SINGLE-BOT setup (recommended): leave these empty. Your existing Chater bot
# is the only Telegram bot; it pulls GET /api/digest/text and serves commands.
# Networking AI does not poll Telegram (no 409 conflict).
#
# Only fill these if you want a SEPARATE Networking AI bot with its OWN token
# (new bot from @BotFather), and also set TELEGRAM_POLLING_ENABLED=true and run
# `python -m app.run_bot`. Do NOT reuse Chater's token for polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING_ENABLED=false

# ── Production (Caddy reverse proxy + auto HTTPS) ───────────────────────────
# Only used with docker-compose.prod.yml. Point the domain's A record at the
# server first, then deploy.
DOMAIN=
ACME_EMAIL=
# Strong password for the bundled Postgres (docker-compose).
POSTGRES_PASSWORD=

# Монітор соцмереж (docs/SOCIAL.md): дописи контактів в Instagram через Apify.
APIFY_API_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
SOCIAL_MONITOR_PER_RUN=10
SOCIAL_MONITOR_EVERY_DAYS=3
SOCIAL_MONITOR_POSTS_LIMIT=12

# Розшифровка голосових у боті. Deepgram — перший, якщо є ключ; далі OpenAI
# Whisper, далі Gemini. TRANSCRIBE_PROVIDER примусово ставить одного першим.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
TRANSCRIBE_PROVIDER=

# ── Фоновий AI: хто думає у фоні (docs/BACKGROUND_AI.md) ────────────────────
# api         — модель через ключ (ANTHROPIC/OPENAI/GEMINI), як завжди
# claude_code — Claude Code на підписці власника: воркер бере задачі з черги
#               і запускає `claude -p` через наш MCP; API лишається відкатом
# off         — фонові AI-задачі вимкнені
BACKGROUND_AI=api
BACKGROUND_AI_FALLBACK=api
# Токен з `claude setup-token` на своєму ПК (потрібна підписка Pro/Max).
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=sonnet
# Гальма для квоти: стеля запусків на годину і тихі години (напр. 23-7).
AIJOBS_MAX_PER_HOUR=40
AIJOBS_QUIET_HOURS=

# ── ALiSiO CRM: той самий бот, її чати лідів (docs/ALISIO.md) ───────────────
# Кожне business_message спершу летить в ALiSiO; handled>0 — чат її, мовчимо.
# Секрет = значення CRM_TELEGRAM_WEBHOOK_SECRET з ALiSiO. Порожньо — вимкнено.
ALISIO_WEBHOOK_SECRET=
